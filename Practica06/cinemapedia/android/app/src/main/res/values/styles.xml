<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema mientras arranca el proceso: muestra launch_background (icono
         sobre el fondo de la marca). Cinemapedia es siempre oscura, por eso
         modo claro y oscuro comparten configuración. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema mientras se dibuja la UI de Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
